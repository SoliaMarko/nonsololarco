# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nonsololarco?schema=public

# API
PORT=3001
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Seeding — attaches seed data to your real OAuth account instead of the
# placeholder user. Leave unset to seed as solomiia@example.com.
SEED_USER_EMAIL=

# E2E — which seeded user Playwright signs in as.
# Defaults to solomiia@example.com. See apps/web/e2e/README.md.
E2E_USER_EMAIL=

# Redis
REDIS_URL=redis://...

# Cloudflare R2
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
