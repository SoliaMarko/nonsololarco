{
  "name": "nonsololarco",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "stylelint": "turbo run stylelint",
    "e2e": "turbo run e2e",
    "check": "turbo run lint stylelint typecheck test build",
    "check:full": "pnpm check && pnpm e2e",
    "ai:map": "node scripts/generate-ai-map.mjs",
    "pr": "bash scripts/open-pr.sh"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  }
}
