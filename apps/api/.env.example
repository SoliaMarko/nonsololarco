# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/nonsololarco
# Railway: provided automatically via DATABASE_URL env var
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nonsololarco?schema=public"

# Frontend origin for CORS (comma-separated for multiple origins)
CORS_ORIGINS="http://localhost:3000"

# Frontend URL for OAuth redirect after login
FRONTEND_URL="http://localhost:3000"

# Server port
PORT=3001

# JWT secret for signing auth tokens (min 32 chars — e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL="http://localhost:3001/api/auth/github/callback"

# Cookie domain (optional — defaults to .nonsololarco.com in production)
# COOKIE_DOMAIN=
